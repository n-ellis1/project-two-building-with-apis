# Copy this file to .env (which is git-ignored) and replace the placeholders.
# Never commit .env.

# Django (required). Generate a key with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# True for local development (runserver serves static files only when True).
DJANGO_DEBUG=True

# IGDB, through your Twitch application (optional: the site starts without them,
# and only IGDB search, save and refresh report a configuration error).
IGDB_CLIENT_ID=your-twitch-client-id
IGDB_CLIENT_SECRET=your-twitch-client-secret
